# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs de disparo (contem dados de compradores)
logs/

# config local com segredos de integracao
/config/

# segredos de operacao gerados na maquina do operador (nunca versionar)
*.local

# Estado de ferramenta de design na maquina do operador. Nada em src/ importa
# estas pastas e o `.dockerignore` nao as exclui -- se fossem versionadas
# entrariam no contexto do build sem servir para nada. Ficam fora.
/.ds-sync/
/ds-bundle/
/.design-sync/
/.impeccable/
