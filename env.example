# Meta — marca padrao "default". O token NUNCA vai para o git nem para o cliente.
PIXEL_ID=
ACCESS_TOKEN=
API_VERSION=v26.0
AD_ACCOUNT_ID=
# Com codigo de teste preenchido, NADA entra nas metricas reais (so Test Events).
TEST_EVENT_CODE=
BRAND_NAME=Código Vencedor

# Console — login via cookie assinado (mínimo 12 chars para CONSOLE_PASSWORD).
# Sem senha, o console responde 503 em tudo, menos webhook e health.
CONSOLE_USER=admin
CONSOLE_PASSWORD=
# Chave secreta de 32+ caracteres para assinar o cookie de sessão.
# Gerar com: openssl rand -base64 32
# Se omitido, deriva via PBKDF2(CONSOLE_PASSWORD) emitindo aviso em produção.
SESSION_SECRET=

# Infra
PUBLIC_BASE_URL=https://capi.proxserverabner.site
TZ=America/Sao_Paulo
APP_VERSION=
