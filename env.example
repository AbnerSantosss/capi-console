# Meta — marca padrao "default". O token NUNCA vai para o git nem para o cliente.
PIXEL_ID=
ACCESS_TOKEN=
API_VERSION=v26.0
AD_ACCOUNT_ID=
# Com codigo de teste preenchido, NADA entra nas metricas reais (so Test Events).
TEST_EVENT_CODE=
BRAND_NAME=Código Vencedor

# Console — obrigatorio em producao. Sem senha (min. 12 chars) o console
# responde 503 em tudo, menos webhook e health.
CONSOLE_USER=admin
CONSOLE_PASSWORD=

# Infra
PUBLIC_BASE_URL=https://capi.proxserverabner.site
TZ=America/Sao_Paulo
APP_VERSION=
